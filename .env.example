NODE_ENV=development

# Optional: colon-separated filesystem roots for path validation (Next.js + stxm-bridge).
# When unset, defaults to your home directory and macOS ~/Library/CloudStorage (OneDrive-*).
# For OneDrive beamtime data you can leave this unset, or set explicitly, e.g.:
# STXM_ALLOWED_ROOTS=$HOME
# STXM_ALLOWED_ROOTS=$HOME/Library/CloudStorage

STXM_DEFAULT_PARENT_DIR=
STXM_ENABLE_DIRECTORY_PICKER=true
